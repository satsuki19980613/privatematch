# 開発用（npm run dev）。値はどれも公開の住所（秘密ではない）。.env.development.local にコピーして使う。
# サーバー無しで画面を見るだけなら不要：http://localhost:5180/?fake
# Neon Auth の URL（neonctl neon-auth status --branch dev）
VITE_NEON_AUTH_URL=
# Neon Data API の URL（neonctl data-api get --branch dev --database neondb）
VITE_NEON_DATA_API_URL=
# Neon Function "game" の URL（npm run deploy:game -- --branch dev）
VITE_GAME_URL=
# データベースの接続文字列はここに書かない。
